{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"jsx": "react-jsx",
		"jsxImportSource": "remix/component",
		"types": ["vite/client"],
		"paths": { "~/*": ["./*"] }
	},
	"include": [
		"app/**/*",
		"bootstrap/**/*",
		"resources/**/*",
		"routes/**/*",
		".cloudflare/types/index.d.ts",
		"cloudflare.config.ts",
		"vite.config.ts"
	]
}
