{
	"name": "moneytracker",
	"private": true,
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "vite build && wrangler deploy",
		"cf:typegen": "wrangler types",
		"format": "oxfmt --check .",
		"format:fix": "oxfmt .",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"db:migrate": "bun --env-file=.dev.vars scripts/migrate.ts"
	},
	"dependencies": {
		"remix": "3.0.0",
		"@libsql/client": "^0.15.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.63.1",
		"@types/node": "^26.4.0",
		"oxfmt": "latest",
		"oxlint": "latest",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"wrangler": "^4.149.0"
	}
}
