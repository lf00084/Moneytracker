{
	"name": "moneytracker",
	"private": true,
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"dev": "vite dev",
		"build": "vite build",
		"start": "vite preview",
		"format": "oxfmt --check .",
		"format:fix": "oxfmt .",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"cf:deploy": "bun run build && bunx wrangler deploy",
		"cf:typegen": "bunx wrangler types",
		"db:generate": "bun db/generate-migrations.ts",
		"db:local:migrate": "bun run db:generate && bunx wrangler d1 migrations apply DB --local",
		"db:remote:migrate": "bun run db:generate && bunx wrangler d1 migrations apply DB --remote"
	},
	"dependencies": {
		"@pitlane/assets": "0.2.0",
		"@pitlane/data-table-d1": "latest",
		"remix": "3.0.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.63.1",
		"@pitlane/vite-plugin-remix": "0.9.0",
		"@types/node": "^26.4.0",
		"oxfmt": "latest",
		"oxlint": "latest",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"wrangler": "^4.149.0"
	}
}
